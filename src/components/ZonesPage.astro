---
import type { Lang } from '../data/i18n';
import { getPageContent } from '../data/pages';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import PageHeader from './PageHeader.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const page = getPageContent(lang).zones;
---

<BaseLayout lang={lang} title={`${page.title} | COST SA`} description={page.description}>
  <Header lang={lang} slot="header" />
  <PageHeader title={page.title} description={page.description} />
  <section class="content-section"><div class="container"><div class="section-header"><h2>{page.heading}</h2><div class="accent-line"></div></div><div class="zones-grid">{page.ports.map((port, index) => <article><span>0{index + 1}</span><h3>{port.city}</h3><p>{port.text}</p></article>)}</div></div></section>
  <Footer lang={lang} slot="footer" />
</BaseLayout>
