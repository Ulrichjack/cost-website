---
import type { Lang } from '../data/i18n';
import { getPageContent } from '../data/pages';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import PageHeader from './PageHeader.astro';
import { galleryAssets, socialActionGalleryAssets } from '../data/gallery';
interface Props { lang: Lang; variant?: 'operations' | 'social' }
const { lang, variant = 'operations' } = Astro.props;
const content = getPageContent(lang);
const isSocial = variant === 'social';
const page = isSocial ? content.socialGallery : content.gallery;
const assets = isSocial ? socialActionGalleryAssets : galleryAssets;
const base = lang === 'fr' ? '' : '/en';
---

<BaseLayout lang={lang} title={`${page.title} | COST SA`} description={page.description} image={isSocial ? socialActionGalleryAssets[0].src : undefined}>
  <Header lang={lang} slot="header" />
  <PageHeader title={page.title} description={page.description} eyebrow={'eyebrow' in page ? page.eyebrow : undefined} />
  <section class:list={['content-section', isSocial && 'social-gallery-section']}>
    <div class="container">
      {isSocial && <a class="gallery-back-link reveal" href={`${base}/galerie`} aria-label={page.backLabel}>← {page.backLabel}</a>}
      <div class="section-header reveal"><h2>{page.heading}</h2><div class="accent-line"></div><p>{page.notice}</p></div>
      {!isSocial && (
        <a class="social-gallery-callout reveal" href={`${base}/galerie-actions-sociales`}>
          <img src={socialActionGalleryAssets[0].src} width={socialActionGalleryAssets[0].width} height={socialActionGalleryAssets[0].height} alt="" loading="lazy" />
          <span class="social-gallery-callout-copy"><small>{lang === 'fr' ? 'Engagement communautaire' : 'Community commitment'}</small><strong>{content.gallery.socialLinkTitle}</strong><span>{content.gallery.socialLinkText}</span><b>{content.gallery.socialLinkLabel} →</b></span>
        </a>
      )}
      <div class:list={['gallery-grid', 'stagger-grid', isSocial && 'gallery-grid-social']}>{page.items.map((item, index) => <figure class="reveal" style={`--delay: ${index * 70}ms`}><button class="gallery-trigger" type="button" data-gallery-open aria-label={`${item} — ${lang === 'fr' ? 'agrandir' : 'enlarge'}`}><div class="gallery-media">{assets[index]?.src && <img src={assets[index].src} width={'width' in assets[index] ? assets[index].width : undefined} height={'height' in assets[index] ? assets[index].height : undefined} alt={item} loading="lazy" />}<div class="gallery-placeholder" aria-hidden="true"><span>0{index + 1}</span></div></div></button><figcaption>{item}</figcaption></figure>)}</div>
    </div>
  </section>
  <div class="gallery-lightbox" id="gallery-lightbox" role="dialog" aria-modal="true" aria-labelledby="gallery-lightbox-title" hidden>
    <div class="gallery-lightbox-backdrop" data-gallery-close></div>
    <div class="gallery-lightbox-panel">
      <button class="gallery-lightbox-close" type="button" data-gallery-close aria-label={lang === 'fr' ? 'Fermer l’image' : 'Close image'}>×</button>
      <button class="gallery-lightbox-nav gallery-lightbox-prev" type="button" data-gallery-prev aria-label={lang === 'fr' ? 'Image précédente' : 'Previous image'}>‹</button>
      <img id="gallery-lightbox-image" src="" alt="" />
      <button class="gallery-lightbox-nav gallery-lightbox-next" type="button" data-gallery-next aria-label={lang === 'fr' ? 'Image suivante' : 'Next image'}>›</button>
      <div class="gallery-lightbox-caption" aria-live="polite">
        <p id="gallery-lightbox-title"></p>
        <span id="gallery-lightbox-counter"></span>
      </div>
    </div>
  </div>
  <Footer lang={lang} slot="footer" />
</BaseLayout>

<script>
  document.querySelectorAll<HTMLImageElement>('.gallery-media img').forEach((image) => {
    const media = image.parentElement;
    const showImage = () => media?.classList.add('has-image');
    if (image.complete && image.naturalWidth > 0) showImage();
    image.addEventListener('load', showImage, { once: true });
    image.addEventListener('error', () => image.remove(), { once: true });
  });

  const lightbox = document.querySelector<HTMLElement>('#gallery-lightbox');
  const lightboxImage = document.querySelector<HTMLImageElement>('#gallery-lightbox-image');
  const lightboxTitle = document.querySelector<HTMLElement>('#gallery-lightbox-title');
  const lightboxCounter = document.querySelector<HTMLElement>('#gallery-lightbox-counter');
  const closeButton = document.querySelector<HTMLButtonElement>('.gallery-lightbox-close');
  const previousButton = document.querySelector<HTMLButtonElement>('[data-gallery-prev]');
  const nextButton = document.querySelector<HTMLButtonElement>('[data-gallery-next]');
  const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-gallery-open]'));
  let lastTrigger: HTMLButtonElement | null = null;
  let currentIndex = 0;
  let touchStartX = 0;

  const showSlide = (index: number) => {
    if (!lightboxImage || !lightboxTitle || !lightboxCounter || triggers.length === 0) return;
    currentIndex = (index + triggers.length) % triggers.length;
    const image = triggers[currentIndex].querySelector<HTMLImageElement>('img');
    if (!image) return;
    lightboxImage.src = image.currentSrc || image.src;
    lightboxImage.alt = image.alt;
    lightboxTitle.textContent = image.alt;
    lightboxCounter.textContent = `${currentIndex + 1} / ${triggers.length}`;
  };

  const closeLightbox = () => {
    if (!lightbox) return;
    lightbox.hidden = true;
    document.body.classList.remove('gallery-is-open');
    lastTrigger?.focus();
  };

  triggers.forEach((trigger, index) => {
    trigger.addEventListener('click', () => {
      const image = trigger.querySelector<HTMLImageElement>('img');
      if (!image || !image.naturalWidth || !lightbox || !lightboxImage || !lightboxTitle) return;
      lastTrigger = trigger;
      showSlide(index);
      lightbox.hidden = false;
      document.body.classList.add('gallery-is-open');
      closeButton?.focus();
    });
  });

  previousButton?.addEventListener('click', () => showSlide(currentIndex - 1));
  nextButton?.addEventListener('click', () => showSlide(currentIndex + 1));
  document.querySelectorAll<HTMLElement>('[data-gallery-close]').forEach((element) => element.addEventListener('click', closeLightbox));
  document.addEventListener('keydown', (event) => {
    if (!lightbox || lightbox.hidden) return;
    if (event.key === 'Escape') closeLightbox();
    if (event.key === 'ArrowLeft') showSlide(currentIndex - 1);
    if (event.key === 'ArrowRight') showSlide(currentIndex + 1);
  });

  lightbox?.addEventListener('touchstart', (event) => {
    touchStartX = event.changedTouches[0]?.clientX ?? 0;
  }, { passive: true });
  lightbox?.addEventListener('touchend', (event) => {
    const distance = (event.changedTouches[0]?.clientX ?? touchStartX) - touchStartX;
    if (Math.abs(distance) < 50) return;
    showSlide(currentIndex + (distance < 0 ? 1 : -1));
  }, { passive: true });
</script>
