---
import type { Lang } from '../data/i18n';
import { translations } from '../data/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = translations[lang];
---

<section class="section coverage-section" id="coverage" aria-labelledby="coverage-title">
  <div class="container coverage-grid">
    <div class="coverage-copy reveal">
      <p class="eyebrow eyebrow-dark">{t.coverage.eyebrow}</p>
      <h2 id="coverage-title">{t.coverage.title}</h2>
      <p class="lead">{t.coverage.text}</p>
    </div>
    <ol class="port-list stagger-grid">
      {t.coverage.ports.map((port, index) => (
        <li class="reveal" style={`--delay: ${index * 90}ms`}><span>0{index + 1}</span><div><strong>{port.city}</strong><small>{port.detail}</small></div></li>
      ))}
    </ol>
  </div>
</section>
