---
import type { Lang } from '../data/i18n';
import { translations } from '../data/i18n';
import { getPageContent } from '../data/pages';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import PageHeader from './PageHeader.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const page = getPageContent(lang).contact;
const t = translations[lang];
const phoneHref = (phone: string) => `tel:${phone.replace(/\D/g, '')}`;
---

<BaseLayout lang={lang} title={`${page.title} | COST SA`} description={page.description}>
  <Header lang={lang} slot="header" />
  <PageHeader title={page.title} description={page.description} />
  <address class="contact-card zoom-in">
    <div>
      <strong>{page.phoneLabel}</strong>
      <a href={phoneHref(t.footer.phone)}>{t.footer.phone}</a>
      <a href={phoneHref(t.footer.phoneMobile)}>{t.footer.phoneMobile}</a>
    </div>
    <div>
      <strong>{page.addressLabel}</strong>
      <p>Rue Tokoto, Bonapriso<br />Douala, Cameroun</p>
    </div>
    <div>
      <strong>{page.socialLabel}</strong>
      {page.socialLinks.map((link) => (
        <a href={link.url} target="_blank" rel="noopener">{link.name}</a>
      ))}
    </div>
</address>
  <Footer lang={lang} slot="footer" />
</BaseLayout>
